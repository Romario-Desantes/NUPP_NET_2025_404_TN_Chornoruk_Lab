@{
    ViewData["Title"] = "Головна сторінка";
}

<div class="text-center">
    <h1 class="display-4">Ласкаво просимо до FigureProj.MVC!</h1>
    <p class="lead">Вебзастосунок для управління геометричними фігурами</p>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <h3>Фігури</h3>
        <p>Управління різними типами геометричних фігур:</p>
        <ul class="list-unstyled">
            <li><a asp-controller="Circles" asp-action="Index">Кола</a></li>
            <li><a asp-controller="Rectangles" asp-action="Index">Прямокутники</a></li>
            <li><a asp-controller="Squares" asp-action="Index">Квадрати</a></li>
            <li><a asp-controller="Triangles" asp-action="Index">Трикутники</a></li>
        </ul>
    </div>
    <div class="col-md-6">
        <h3>Колекції та Теги</h3>
        <p>Організація фігур за допомогою колекцій та тегів:</p>
        <ul class="list-unstyled">
            <li><a asp-controller="Collections" asp-action="Index">Колекції</a></li>
            <li><a asp-controller="Tags" asp-action="Index">Теги</a></li>
        </ul>
    </div>
</div>
